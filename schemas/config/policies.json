{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "allow_globs": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "actions": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "add_labels": {
          "$ref": "#/$defs/Disposition"
        },
        "change_repo_settings": {
          "$ref": "#/$defs/Disposition"
        },
        "close_issue": {
          "$ref": "#/$defs/Disposition"
        },
        "create_comment": {
          "$ref": "#/$defs/Disposition"
        },
        "create_issue": {
          "$ref": "#/$defs/Disposition"
        },
        "create_pr": {
          "$ref": "#/$defs/Disposition"
        },
        "delete_branch": {
          "$ref": "#/$defs/Disposition"
        },
        "force_push": {
          "$ref": "#/$defs/Disposition"
        },
        "merge_pr": {
          "$ref": "#/$defs/Disposition"
        },
        "publish_release": {
          "$ref": "#/$defs/Disposition"
        },
        "push_branch": {
          "$ref": "#/$defs/Disposition"
        },
        "push_outside_prefix": {
          "$ref": "#/$defs/Disposition"
        },
        "reply_review_thread": {
          "$ref": "#/$defs/Disposition"
        },
        "request_reviewers": {
          "$ref": "#/$defs/Disposition"
        },
        "rerun_failed_jobs": {
          "$ref": "#/$defs/Disposition"
        },
        "resolve_review_thread": {
          "$ref": "#/$defs/Disposition"
        },
        "resolve_review_thread_human": {
          "$ref": "#/$defs/Disposition"
        },
        "update_issue": {
          "$ref": "#/$defs/Disposition"
        },
        "update_pr": {
          "$ref": "#/$defs/Disposition"
        },
        "upsert_status_comment": {
          "$ref": "#/$defs/Disposition"
        }
      }
    },
    "unlisted_action": {
      "anyOf": [
        {
          "$ref": "#/$defs/UnlistedDisposition"
        },
        {
          "type": "null"
        }
      ]
    },
    "paths": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/PathRulePatch"
      }
    },
    "escalation": {
      "anyOf": [
        {
          "$ref": "#/$defs/EscalationPatch"
        },
        {
          "type": "null"
        }
      ]
    },
    "approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalPatch"
        },
        {
          "type": "null"
        }
      ]
    },
    "patch": {
