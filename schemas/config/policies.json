        {
          "$ref": "#/$defs/PatchLimitsPatch"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "title": "PoliciesPatch",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Disposition": {
      "type": "string",
      "enum": [
        "auto",
        "approve",
        "deny"
      ]
    },
    "UnlistedDisposition": {
      "type": "string",
      "enum": [
        "approve",
        "deny"
      ]
    },
    "PathRulePatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "globs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "disposition": {
          "anyOf": [
            {
              "$ref": "#/$defs/PathDisposition"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "PathDisposition": {
      "type": "string",
      "enum": [
        "approve",
        "deny"
      ]
    },
    "EscalationPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "rules": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/EscalationRule"
          }
        }
      }
    },
    "EscalationRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "when": {
          "$ref": "#/$defs/EscalationWhen"
        },
        "raise_to": {
          "$ref": "#/$defs/EscalationLevel"
        }
      },
      "required": [
        "when",
        "raise_to"
      ]
    },
    "EscalationWhen": {
      "anyOf": [
        {
          "$ref": "#/$defs/WhenPaths"
        },
        {
          "$ref": "#/$defs/WhenDiff"
        },
        {
          "$ref": "#/$defs/WhenLabels"
        }
      ]
    },
    "WhenPaths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "paths"
      ]
    },
    "WhenDiff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "diff": {
          "$ref": "#/$defs/DiffThreshold"
        }
      },
      "required": [
        "diff"
      ]
    },
    "DiffThreshold": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files_gte": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "lines_gte": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    },
    "WhenLabels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "labels"
      ]
    },
    "EscalationLevel": {
      "type": "string",
      "enum": [
        "Medium",
        "High",
        "Max"
      ]
    },
    "ApprovalPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ttl_s": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    },
    "PatchLimitsPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_files": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "max_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "max_changed_lines": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "max_file_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    }
  },
  "x-gantry-dialect": "https://json-schema.org/draft/2020-12/schema",
  "x-gantry-resource": "policies"
}
