{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "app": {
      "anyOf": [
        {
          "$ref": "#/$defs/GithubAppPatch"
        },
        {
          "type": "null"
        }
      ]
    },
    "commit_identity": {
      "anyOf": [
        {
          "$ref": "#/$defs/CommitIdentity"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "title": "GithubPatch",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "GithubAppPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "app_id": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "private_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/SecretRefWrite"
            },
            {
              "type": "null"
            }
          ]
        },
        "webhook_secret": {
          "anyOf": [
            {
              "$ref": "#/$defs/SecretRefWrite"
            },
            {
              "type": "null"
            }
          ]
        },
        "webhook_secret_previous": {
          "anyOf": [
            {
              "$ref": "#/$defs/SecretRefWrite"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "SecretRefWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secret_ref"
      ],
      "properties": {
        "secret_ref": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "present": {
          "type": "boolean",
          "readOnly": true
        },
        "value": {
          "type": "string",
          "writeOnly": true
        }
      },
      "x-gantry-secret": true
    },
    "CommitIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "email"
      ]
    }
  },
  "x-gantry-dialect": "https://json-schema.org/draft/2020-12/schema",
  "x-gantry-resource": "github"
}
