{
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/Id_dev"
    },
    "name": {
      "type": "string"
    },
    "platform": {
      "$ref": "#/$defs/DevicePlatform"
    },
    "cert_serial": {
      "type": "string"
    },
    "pubkey_fpr": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "approval_pubkey": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "approval_pubkey_fpr": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sha256Digest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "role": {
      "$ref": "#/$defs/DeviceRole"
    },
    "status": {
      "$ref": "#/$defs/DeviceStatus"
    },
    "last_seen": {
      "anyOf": [
        {
          "$ref": "#/$defs/Timestamp"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created_at": {
      "$ref": "#/$defs/Timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/Timestamp"
    }
  },
  "required": [
    "id",
    "name",
    "platform",
    "cert_serial",
    "pubkey_fpr",
    "role",
    "status",
    "created_at",
    "updated_at"
  ],
  "title": "Device",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Id_dev": {
      "type": "string",
      "pattern": "^dev_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "DevicePlatform": {
      "type": "string",
      "enum": [
        "windows",
        "macos",
        "ios"
      ]
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "DeviceRole": {
      "type": "string",
      "enum": [
        "viewer",
        "operator",
        "approver"
      ]
    },
    "DeviceStatus": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ]
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  },
  "x-gantry-dialect": "https://json-schema.org/draft/2020-12/schema",
  "x-gantry-source": "entities::Device"
}
