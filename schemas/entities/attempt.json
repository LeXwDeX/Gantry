{
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/Id_att"
    },
    "node_id": {
      "$ref": "#/$defs/Id_nod"
    },
    "n": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "sandbox_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Id_sbx"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "$ref": "#/$defs/AttemptStatus"
    },
    "started_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/Timestamp"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ended_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/Timestamp"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "result_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sha256Digest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "failure_class": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureClass"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "failure_detail": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureDetail"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "usage": {
      "$ref": "#/$defs/TokenUsage"
    },
    "created_at": {
      "$ref": "#/$defs/Timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/Timestamp"
    }
  },
  "required": [
    "id",
    "node_id",
    "n",
    "status",
    "usage",
    "created_at",
    "updated_at"
  ],
  "title": "Attempt",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Id_att": {
      "type": "string",
      "pattern": "^att_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "Id_nod": {
      "type": "string",
      "pattern": "^nod_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "Id_sbx": {
      "type": "string",
      "pattern": "^sbx_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "AttemptStatus": {
      "type": "string",
      "enum": [
        "preparing",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "FailureClass": {
      "type": "string",
      "enum": [
        "timeout",
        "exec_failed",
        "verdict_fail",
        "policy_denied",
        "cancelled",
        "budget_exhausted",
        "infra_error"
      ]
    },
    "FailureDetail": {
      "type": "string",
      "pattern": "^[a-z0-9_.:-]{1,200}$"
    },
    "TokenUsage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "requests": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "requests"
      ]
    }
  },
  "x-gantry-dialect": "https://json-schema.org/draft/2020-12/schema",
  "x-gantry-source": "entities::Attempt"
}
