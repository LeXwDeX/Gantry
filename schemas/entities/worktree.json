{
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/Id_wtr"
    },
    "project_id": {
      "$ref": "#/$defs/Id_prj"
    },
    "branch": {
      "type": "string"
    },
    "base_ref": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "lock": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorktreeLock"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created_at": {
      "$ref": "#/$defs/Timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/Timestamp"
    }
  },
  "required": [
    "id",
    "project_id",
    "branch",
    "base_ref",
    "path",
    "created_at",
    "updated_at"
  ],
  "title": "Worktree",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Id_wtr": {
      "type": "string",
      "pattern": "^wtr_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "Id_prj": {
      "type": "string",
      "pattern": "^prj_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "WorktreeLock": {
      "type": "object",
      "properties": {
        "holder": {
          "$ref": "#/$defs/LockHolder"
        },
        "delivery_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id_dlv"
            },
            {
              "type": "null"
            }
          ],
          "description": "engine / guardian 锁必填；人工锁为 `null`（#122）。",
          "default": null
        },
        "acquired_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "lease_until": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "holder",
        "acquired_at",
        "lease_until"
      ]
    },
    "LockHolder": {
      "type": "string",
      "enum": [
        "engine",
        "guardian",
        "human"
      ]
    },
    "Id_dlv": {
      "type": "string",
      "pattern": "^dlv_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  },
  "x-gantry-dialect": "https://json-schema.org/draft/2020-12/schema",
  "x-gantry-source": "entities::Worktree"
}
