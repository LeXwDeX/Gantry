{
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/Id_dlv"
    },
    "project_id": {
      "$ref": "#/$defs/Id_prj"
    },
    "title": {
      "type": "string"
    },
    "level_cap": {
      "$ref": "#/$defs/Level"
    },
    "level_effective": {
      "$ref": "#/$defs/Level"
    },
    "stage": {
      "$ref": "#/$defs/Stage"
    },
    "stage_status": {
      "$ref": "#/$defs/StageStatus"
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/IssueRef"
      }
    },
    "pr": {
      "anyOf": [
        {
          "$ref": "#/$defs/PullRequestRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "worktree_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Id_wtr"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "parent_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Id_dlv"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "depends_on": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Id_dlv"
      }
    },
    "origin": {
      "$ref": "#/$defs/DeliveryOrigin"
    },
    "created_at": {
      "$ref": "#/$defs/Timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/Timestamp"
    }
  },
  "required": [
    "id",
    "project_id",
    "title",
    "level_cap",
    "level_effective",
    "stage",
    "stage_status",
    "issues",
    "depends_on",
    "origin",
    "created_at",
    "updated_at"
  ],
  "title": "Delivery",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Id_dlv": {
      "type": "string",
      "pattern": "^dlv_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "Id_prj": {
      "type": "string",
      "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "Level": {
      "type": "string",
      "enum": [
        "None",
        "Low",
        "Medium",
        "High",
        "Max",
        "Ultimate"
      ],
      "description": "线上档位值：`\"None\"`…`\"Ultimate\"`。"
    },
    "Stage": {
      "type": "string",
      "enum": [
        "spec",
        "plan",
        "implement",
        "propose",
        "review",
        "merge",
        "closed",
        "abandoned"
      ]
    },
    "StageStatus": {
      "type": "string",
      "enum": [
        "running",
        "waiting_human",
        "blocked",
        "paused",
        "done"
      ]
    },
    "IssueRef": {
      "type": "object",
      "properties": {
        "repo": {
          "$ref": "#/$defs/RepoSlug"
        },
        "number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "node_id": {
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/UntrustedText"
        },
        "state": {
          "$ref": "#/$defs/IssueState"
        },
        "state_reason": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "synced_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "repo",
        "number",
        "node_id",
        "title",
        "state",
        "synced_at"
      ]
    },
    "RepoSlug": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,100}/[A-Za-z0-9._-]{1,100}$"
    },
    "UntrustedText": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "source",
        "truncated"
      ],
      "description": "来自 GitHub、沙盒或其他外部来源的文本。\n\n刻意不实现 `Deref<Target = str>`、`Display`、`AsRef<str>`；取内容必须调用\n[`UntrustedText::as_untrusted_str`]，`Debug` 不输出正文。"
    },
    "IssueState": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ]
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "PullRequestRef": {
      "type": "object",
      "properties": {
        "repo": {
          "$ref": "#/$defs/RepoSlug"
        },
        "number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "node_id": {
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/UntrustedText"
        },
        "state": {
          "$ref": "#/$defs/PullRequestState"
        },
        "head_sha": {
          "$ref": "#/$defs/GitOid"
        },
        "base_ref": {
          "type": "string"
        },
        "base_sha": {
          "$ref": "#/$defs/GitOid"
        },
        "draft": {
          "type": "boolean"
        },
        "mergeable_state": {
          "type": "string"
        },
        "in_merge_queue": {
          "type": "boolean"
        },
        "checks": {
          "$ref": "#/$defs/CheckSummary"
        },
        "review_state": {
          "$ref": "#/$defs/ReviewState"
        },
        "synced_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "repo",
        "number",
        "node_id",
        "title",
        "state",
        "head_sha",
        "base_ref",
        "base_sha",
        "draft",
        "mergeable_state",
        "in_merge_queue",
        "checks",
        "review_state",
        "synced_at"
      ]
    },
    "PullRequestState": {
      "type": "string",
      "enum": [
        "open",
        "closed",
        "merged"
      ]
    },
    "GitOid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "CheckSummary": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "required_ok": {
          "type": "boolean"
        }
      },
      "required": [
        "passed",
        "failed",
        "pending",
        "required_ok"
      ]
    },
    "ReviewState": {
      "type": "string",
      "enum": [
        "none",
        "approved",
        "changes_requested"
      ]
    },
    "Id_wtr": {
      "type": "string",
      "pattern": "^wtr_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "DeliveryOrigin": {
      "type": "string",
      "enum": [
        "conversation",
        "github_label",
        "github_command"
      ]
    }
  },
  "x-gantry-dialect": "https://json-schema.org/draft/2020-12/schema",
  "x-gantry-source": "entities::Delivery"
}
