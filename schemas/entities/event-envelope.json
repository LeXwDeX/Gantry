{
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/Id_evt"
    },
    "seq": {
      "$ref": "#/$defs/Seq"
    },
    "ts": {
      "$ref": "#/$defs/Timestamp"
    },
    "type": {
      "$ref": "#/$defs/EventType"
    },
    "subject": {
      "$ref": "#/$defs/Subject"
    },
    "project_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Id_prj"
        },
        {
          "type": "null"
        }
      ]
    },
    "actor": {
      "$ref": "#/$defs/Actor"
    },
    "causation_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Id_evt"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "data": true
  },
  "required": [
    "id",
    "seq",
    "ts",
    "type",
    "subject",
    "actor",
    "data"
  ],
  "description": "data-model §5.1 信封。字段名逐字一致；`type` 用 `ty` 承载。",
  "title": "Event",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Id_evt": {
      "type": "string",
      "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "Seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "EventType": {
      "type": "string",
      "enum": [
        "project.added",
        "project.updated",
        "settings.updated",
        "conversation.created",
        "delivery.created",
        "delivery.stage_changed",
        "delivery.level_changed",
        "delivery.abandoned",
        "delivery.paused",
        "delivery.resumed",
        "workflow.created",
        "workflow.revised",
        "workflow.finished",
        "node.queued",
        "node.started",
        "node.finished",
        "node.superseded",
        "node.retry_requested",
        "attempt.started",
        "attempt.finished",
        "attempt.progress",
        "patch.validated",
        "patch.rejected",
        "sandbox.created",
        "sandbox.destroyed",
        "worktree.created",
        "worktree.locked",
        "worktree.unlocked",
        "worktree.removed",
        "message.posted",
        "inbox.raised",
        "inbox.resolved",
        "inbox.dismissed",
        "guardian.triaged",
        "guardian.heal_requested",
        "guardian.escalated",
        "approval.requested",
        "approval.granted",
        "approval.consumed",
        "approval.invalidated",
        "approval.expired",
        "approval.denied",
        "outbox.enqueued",
        "outbox.executing",
        "outbox.succeeded",
        "outbox.failed",
        "outbox.cancelled",
        "forge.pr_opened",
        "forge.pr_reopened",
        "forge.pr_synchronized",
        "forge.pr_updated",
        "forge.pr_closed",
        "forge.pr_merged",
        "forge.base_advanced",
        "forge.pr_enqueued",
        "forge.pr_dequeued",
        "forge.merge_group_checks_requested",
        "forge.merge_group_destroyed",
        "forge.check_suite_completed",
        "forge.check_run_completed",
        "forge.review_submitted",
        "forge.review_dismissed",
        "forge.review_comment",
        "forge.review_thread_changed",
        "forge.issue_comment",
        "forge.issue_closed",
        "forge.issue_reopened",
        "forge.issue_updated",
        "forge.installation_changed",
        "forge.repo_changed",
        "forge.synced",
        "forge.drift_detected",
        "budget.charged",
        "budget.exhausted",
        "policy.denied",
        "device.paired",
        "device.updated",
        "device.revoked"
      ]
    },
    "Subject": {
      "type": "string",
      "pattern": "^(settings|(prj|dlv|wfl|nod|att|wtr|sbx|cnv|msg|inb|apr|act|dev|evt|bdg)_[0-9A-HJKMNP-TV-Z]{26})$"
    },
    "Id_prj": {
      "type": "string",
      "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "Actor": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "ActorKind": {
      "type": "string",
      "enum": [
        "engine",
        "guardian",
        "user",
        "device",
        "forge",
        "system"
      ]
    }
  },
  "x-gantry-dialect": "https://json-schema.org/draft/2020-12/schema",
  "x-gantry-source": "events::Event<serde_json::Value>",
  "x-gantry-data-schema": "schemas/events/<type>.json"
}
