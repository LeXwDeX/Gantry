{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "round_id": {
      "$ref": "#/$defs/Ulid"
    },
    "delivery_id": {
      "$ref": "#/$defs/Id_dlv"
    },
    "task": {
      "$ref": "#/$defs/GuardianHealTask"
    },
    "head_sha": {
      "$ref": "#/$defs/GitOid"
    },
    "problems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GuardianProblem"
      }
    },
    "batch_included": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Sha256Digest"
      }
    },
    "request_digest": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "config_rev": {
      "$ref": "#/$defs/Seq"
    }
  },
  "required": [
    "round_id",
    "delivery_id",
    "task",
    "head_sha",
    "problems",
    "batch_included",
    "request_digest",
    "config_rev"
  ],
  "title": "GuardianHealRequestedData",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Ulid": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "Id_dlv": {
      "type": "string",
      "pattern": "^dlv_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "GuardianHealTask": {
      "type": "string",
      "enum": [
        "ci_failure",
        "bot_finding",
        "mechanical_conflict",
        "nit_batch"
      ]
    },
    "GitOid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "GuardianProblem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "kind": {
          "$ref": "#/$defs/GuardianProblemKind"
        }
      },
      "required": [
        "fingerprint",
        "kind"
      ]
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "GuardianProblemKind": {
      "type": "string",
      "enum": [
        "ci_failure_in_scope",
        "bot_finding_valid",
        "bot_finding_invalid",
        "mechanical_conflict",
        "nit"
      ]
    },
    "Seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "x-gantry-dialect": "https://json-schema.org/draft/2020-12/schema",
  "x-gantry-event-type": "guardian.heal_requested",
  "x-gantry-envelope": "schemas/entities/event-envelope.json"
}
