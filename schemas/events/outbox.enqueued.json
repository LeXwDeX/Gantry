{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/OutboxEnqueuedAction"
    }
  },
  "required": [
    "action"
  ],
  "title": "OutboxEnqueuedData",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "OutboxEnqueuedAction": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/OutboxEnqueuedActionBase"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "push_branch"
                },
                "payload": {
                  "$ref": "#/$defs/PushBranchPayload"
                }
              },
              "required": [
                "kind",
                "payload"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/OutboxEnqueuedActionBase"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "create_pr"
                },
                "payload": {
                  "$ref": "#/$defs/CreatePrPayload"
                }
              },
              "required": [
                "kind",
                "payload"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/OutboxEnqueuedActionBase"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "update_pr"
                },
                "payload": {
                  "$ref": "#/$defs/UpdatePrPayload"
                }
              },
              "required": [
                "kind",
                "payload"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/OutboxEnqueuedActionBase"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "upsert_status_comment"
                },
                "payload": {
                  "$ref": "#/$defs/UpsertStatusCommentPayload"
                }
              },
              "required": [
                "kind",
                "payload"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/OutboxEnqueuedActionBase"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "create_comment"
                },
                "payload": {
                  "$ref": "#/$defs/CreateCommentPayload"
                }
              },
              "required": [
                "kind",
                "payload"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/OutboxEnqueuedActionBase"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "reply_review_thread"
                },
                "payload": {
                  "$ref": "#/$defs/ReplyReviewThreadPayload"
                }
              },
              "required": [
                "kind",
                "payload"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/OutboxEnqueuedActionBase"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "resolve_review_thread"
                },
                "payload": {
                  "$ref": "#/$defs/ResolveReviewThreadPayload"
                }
              },
              "required": [
                "kind",
                "payload"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/OutboxEnqueuedActionBase"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "create_issue"
                },
                "payload": {
                  "$ref": "#/$defs/CreateIssuePayload"
                }
              },
              "required": [
                "kind",
                "payload"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/OutboxEnqueuedActionBase"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "update_issue"
                },
                "payload": {
                  "$ref": "#/$defs/UpdateIssuePayload"
                }
              },
              "required": [
                "kind",
                "payload"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/OutboxEnqueuedActionBase"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "close_issue"
                },
                "payload": {
                  "$ref": "#/$defs/CloseIssuePayload"
                }
              },
              "required": [
                "kind",
                "payload"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/OutboxEnqueuedActionBase"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "add_labels"
                },
                "payload": {
                  "$ref": "#/$defs/AddLabelsPayload"
                }
              },
              "required": [
                "kind",
                "payload"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/OutboxEnqueuedActionBase"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "request_reviewers"
                },
                "payload": {
                  "$ref": "#/$defs/RequestReviewersPayload"
                }
              },
              "required": [
                "kind",
                "payload"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/OutboxEnqueuedActionBase"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "merge_pr"
                },
                "payload": {
                  "$ref": "#/$defs/MergePrPayload"
                }
              },
              "required": [
                "kind",
                "payload"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/OutboxEnqueuedActionBase"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "rerun_failed_jobs"
                },
                "payload": {
                  "$ref": "#/$defs/RerunFailedJobsPayload"
                }
              },
              "required": [
                "kind",
                "payload"
              ]
            }
          ]
        }
      ],
      "description": "outbox.enqueued 的不可变入队意图；`kind` 与 `payload` 必须联动。"
    },
    "OutboxEnqueuedActionBase": {
      "type": "object",
      "properties": {
        "delivery_id": {
          "$ref": "#/$defs/Id_dlv"
        },
        "kind": {
          "$ref": "#/$defs/ForgeActionKind"
        },
        "payload": true,
        "target": {
          "type": "string"
        },
        "intent": {
          "$ref": "#/$defs/OutboxIntent"
        },
        "idempotency_key": {
          "$ref": "#/$defs/IdempotencyKey"
        },
        "requires_approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id_apr"
            },
            {
              "type": "null"
            }
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id_act"
          }
        },
        "priority": {
          "$ref": "#/$defs/Priority"
        },
        "not_before": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "epoch": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "coalesce_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "enqueued_by": {
          "$ref": "#/$defs/OutboxEnqueuedBy"
        }
      },
      "required": [
        "delivery_id",
        "kind",
        "payload",
        "target",
        "intent",
        "idempotency_key",
        "depends_on",
        "priority",
        "epoch",
        "enqueued_by"
      ],
      "additionalProperties": false
    },
    "Id_dlv": {
      "type": "string",
      "pattern": "^dlv_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "ForgeActionKind": {
      "type": "string",
      "enum": [
        "push_branch",
        "create_pr",
        "update_pr",
        "upsert_status_comment",
        "create_comment",
        "reply_review_thread",
        "resolve_review_thread",
        "create_issue",
        "update_issue",
        "close_issue",
        "add_labels",
        "request_reviewers",
        "merge_pr",
        "rerun_failed_jobs"
      ]
    },
    "OutboxIntent": {
      "anyOf": [
        {
          "$ref": "#/$defs/PushBranchIntent"
        },
        {
          "$ref": "#/$defs/CreatePrIntent"
        },
        {
          "$ref": "#/$defs/UpdatePrIntent"
        },
        {
          "$ref": "#/$defs/UpsertStatusCommentIntent"
        },
        {
          "$ref": "#/$defs/CreateCommentIntent"
        },
        {
          "$ref": "#/$defs/ReplyReviewThreadIntent"
        },
        {
          "$ref": "#/$defs/ResolveReviewThreadIntent"
        },
        {
          "$ref": "#/$defs/CreateIssueIntent"
        },
        {
          "$ref": "#/$defs/UpdateIssueIntent"
        },
        {
          "$ref": "#/$defs/CloseIssueIntent"
        },
        {
          "$ref": "#/$defs/AddLabelsIntent"
        },
        {
          "$ref": "#/$defs/RequestReviewersIntent"
        },
        {
          "$ref": "#/$defs/MergePrIntent"
        },
        {
          "$ref": "#/$defs/RerunFailedJobsIntent"
        }
      ]
    },
    "PushBranchIntent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local_head_oid": {
          "$ref": "#/$defs/GitOid"
        },
        "expected_remote_oid": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitOid"
            },
            {
              "type": "null"
            }
          ]
        },
        "force": {
          "type": "boolean"
        }
      },
      "required": [
        "local_head_oid",
        "force"
      ]
    },
    "GitOid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "CreatePrIntent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "draft": {
          "type": "boolean"
        },
        "closes": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        }
      },
      "required": [
        "base",
        "head",
        "title",
        "body",
        "draft",
        "closes"
      ]
    },
    "UpdatePrIntent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "body": {
          "type": [
            "string",
            "null"
          ]
        },
        "base": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrState"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "PrState": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ]
    },
    "UpsertStatusCommentIntent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "render_digest": {
          "$ref": "#/$defs/Sha256Digest"
        }
      },
      "required": [
        "revision",
        "render_digest"
      ]
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "CreateCommentIntent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": "string"
        }
      },
      "required": [
        "body"
      ]
    },
    "ReplyReviewThreadIntent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": "string"
        },
        "in_reply_to_comment_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "body",
        "in_reply_to_comment_id"
      ]
    },
    "ResolveReviewThreadIntent": {
      "type": "object",
      "additionalProperties": false
    },
    "CreateIssueIntent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assignees": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "milestone": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "title",
        "body",
        "labels",
        "assignees"
      ]
    },
    "UpdateIssueIntent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spec_block_digest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "labels": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "spec_block_digest"
      ]
    },
    "CloseIssueIntent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state_reason": {
          "$ref": "#/$defs/IssueStateReason"
        },
        "require_merged_pr": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "state_reason"
      ]
    },
    "IssueStateReason": {
      "type": "string",
      "enum": [
        "completed",
        "not_planned"
      ]
    },
    "AddLabelsIntent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "labels"
      ]
    },
    "RequestReviewersIntent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reviewers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "team_reviewers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "reviewers",
        "team_reviewers"
      ]
    },
    "MergePrIntent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_head_sha": {
          "$ref": "#/$defs/GitOid"
        },
        "merge_method": {
          "$ref": "#/$defs/MergeMethod"
        },
        "mode": {
          "$ref": "#/$defs/MergeMode"
        },
        "commit_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit_message": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "expected_head_sha",
        "merge_method",
        "mode"
      ]
    },
    "MergeMethod": {
      "type": "string",
      "enum": [
        "merge",
        "squash",
        "rebase"
      ]
    },
    "MergeMode": {
      "type": "string",
      "enum": [
        "auto"
      ],
      "description": "`mode` 目前只定义 `auto`；其他合并队列模式见 forge-actions OQ-1，未冻结前拒绝。"
    },
    "RerunFailedJobsIntent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_run_attempt": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "head_sha": {
          "$ref": "#/$defs/GitOid"
        }
      },
      "required": [
        "expected_run_attempt",
        "head_sha"
      ]
    },
    "IdempotencyKey": {
      "type": "string",
      "pattern": "^gk1_[a-z2-7]{26}$"
    },
    "Id_apr": {
      "type": "string",
      "pattern": "^apr_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "Id_act": {
      "type": "string",
      "pattern": "^act_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "Priority": {
      "type": "string",
      "enum": [
        "high",
        "normal",
        "low"
      ]
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "OutboxEnqueuedBy": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string"
        },
        "causation_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id_evt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "module"
      ]
    },
    "Id_evt": {
      "type": "string",
      "pattern": "^evt_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "PushBranchPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {
          "$ref": "#/$defs/RepoSlug"
        },
        "branch": {
          "type": "string"
        },
        "base_ref": {
          "type": "string"
        },
        "worktree_id": {
          "$ref": "#/$defs/Id_wtr"
        },
        "local_head_oid": {
          "$ref": "#/$defs/GitOid"
        },
        "expected_tree_oid": {
          "$ref": "#/$defs/GitOid"
        },
        "expected_remote_oid": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitOid"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "validation_ref": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "transport": {
          "$ref": "#/$defs/PushTransport"
        },
        "force": {
          "type": "boolean"
        }
      },
      "required": [
        "repo",
        "branch",
        "base_ref",
        "worktree_id",
        "local_head_oid",
        "expected_tree_oid",
        "validation_ref",
        "transport",
        "force"
      ]
    },
    "RepoSlug": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,100}/[A-Za-z0-9._-]{1,100}$"
    },
    "Id_wtr": {
      "type": "string",
      "pattern": "^wtr_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "PushTransport": {
      "type": "string",
      "enum": [
        "git",
        "api"
      ]
    },
    "CreatePrPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {
          "$ref": "#/$defs/RepoSlug"
        },
        "head": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "draft": {
          "type": "boolean"
        },
        "closes": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "expected_head_oid": {
          "$ref": "#/$defs/GitOid"
        },
        "maintainer_can_modify": {
          "type": "boolean"
        }
      },
      "required": [
        "repo",
        "head",
        "base",
        "title",
        "body",
        "draft",
        "closes",
        "expected_head_oid",
        "maintainer_can_modify"
      ]
    },
    "UpdatePrPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {
          "$ref": "#/$defs/RepoSlug"
        },
        "pull_number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "body": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "base": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "repo",
        "pull_number"
      ]
    },
    "UpsertStatusCommentPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {
          "$ref": "#/$defs/RepoSlug"
        },
        "target": {
          "$ref": "#/$defs/CommentTarget"
        },
        "slot": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "head_sha": {
          "$ref": "#/$defs/GitOid"
        },
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StatusCommentItem"
          }
        }
      },
      "required": [
        "repo",
        "target",
        "slot",
        "revision",
        "head_sha",
        "title",
        "items"
      ]
    },
    "CommentTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/CommentTargetType"
        },
        "number": {
          "type": "integer",
