{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "target": {
      "$ref": "#/$defs/ForgeSyncedTarget"
    },
    "source": {
      "$ref": "#/$defs/ForgeEventSource"
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ForgeSyncedChange"
      },
      "description": "首次快照时为空，字段全部在 `initial` 里。"
    },
    "synced_at": {
      "$ref": "#/$defs/Timestamp"
    },
    "initial": {
      "anyOf": [
        {
          "$ref": "#/$defs/ForgeSyncedInitial"
        },
        {
          "type": "null"
        }
      ],
      "description": "只在首次快照出现；之后的同步一律只发 `changes`。"
    }
  },
  "required": [
    "target",
    "source",
    "changes",
    "synced_at"
  ],
  "title": "ForgeSyncedData",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ForgeSyncedTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/ForgeSyncedTargetKind"
        },
        "number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "node_id": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "number",
        "node_id"
      ]
    },
    "ForgeSyncedTargetKind": {
      "type": "string",
      "enum": [
        "pr",
        "issue"
      ]
    },
    "ForgeEventSource": {
      "type": "string",
      "enum": [
        "webhook",
        "reconcile"
      ]
    },
    "ForgeSyncedChange": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "const": "state"
            },
            "from": {
              "$ref": "#/$defs/ForgeSyncedState"
            },
            "to": {
              "$ref": "#/$defs/ForgeSyncedState"
            }
          },
          "required": [
            "field",
            "from",
            "to"
          ]
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "const": "state_reason"
            },
            "from": {
              "anyOf": [
                {
                  "$ref": "#/$defs/IssueStateReason"
                },
                {
                  "type": "null"
                }
              ]
            },
            "to": {
              "anyOf": [
                {
                  "$ref": "#/$defs/IssueStateReason"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "field"
          ]
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "const": "title"
            },
            "from": {
              "$ref": "#/$defs/UntrustedText"
            },
            "to": {
              "$ref": "#/$defs/UntrustedText"
            }
          },
          "required": [
            "field",
            "from",
            "to"
          ]
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "const": "head_sha"
            },
            "from": {
              "$ref": "#/$defs/GitOid"
            },
            "to": {
              "$ref": "#/$defs/GitOid"
            }
          },
          "required": [
            "field",
            "from",
            "to"
          ]
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "const": "base_ref"
            },
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            }
          },
          "required": [
            "field",
            "from",
            "to"
          ]
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "const": "base_sha"
            },
            "from": {
              "$ref": "#/$defs/GitOid"
            },
            "to": {
              "$ref": "#/$defs/GitOid"
            }
          },
          "required": [
            "field",
            "from",
            "to"
          ]
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "const": "draft"
            },
            "from": {
              "type": "boolean"
            },
            "to": {
              "type": "boolean"
            }
          },
          "required": [
            "field",
            "from",
            "to"
          ]
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "const": "mergeable_state"
            },
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            }
          },
          "required": [
            "field",
            "from",
            "to"
          ]
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "const": "in_merge_queue"
            },
            "from": {
              "type": "boolean"
            },
            "to": {
              "type": "boolean"
            }
          },
          "required": [
            "field",
            "from",
            "to"
          ]
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "const": "checks"
            },
            "from": {
              "$ref": "#/$defs/CheckSummary"
            },
            "to": {
              "$ref": "#/$defs/CheckSummary"
            }
          },
          "required": [
            "field",
            "from",
            "to"
          ]
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "const": "review_state"
            },
            "from": {
              "$ref": "#/$defs/ReviewState"
            },
            "to": {
              "$ref": "#/$defs/ReviewState"
            }
          },
          "required": [
            "field",
            "from",
            "to"
          ]
        }
      ]
    },
    "ForgeSyncedState": {
      "type": "string",
      "enum": [
        "open",
        "closed",
        "merged"
      ]
    },
    "IssueStateReason": {
      "type": "string",
      "enum": [
        "completed",
        "not_planned"
      ]
    },
    "UntrustedText": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "source",
        "truncated"
      ],
      "description": "来自 GitHub、沙盒或其他外部来源的文本。\n\n刻意不实现 `Deref<Target = str>`、`Display`、`AsRef<str>`；取内容必须调用\n[`UntrustedText::as_untrusted_str`]，`Debug` 不输出正文。"
    },
    "GitOid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "CheckSummary": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "required_ok": {
          "type": "boolean"
        }
      },
      "required": [
        "passed",
        "failed",
        "pending",
        "required_ok"
      ]
    },
    "ReviewState": {
      "type": "string",
      "enum": [
        "none",
        "approved",
        "changes_requested"
      ]
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "ForgeSyncedInitial": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "pr"
            },
            "state": {
              "$ref": "#/$defs/ForgeSyncedState"
            },
            "title": {
              "$ref": "#/$defs/UntrustedText"
            },
            "head_sha": {
              "$ref": "#/$defs/GitOid"
            },
            "base_ref": {
              "type": "string"
            },
            "base_sha": {
              "$ref": "#/$defs/GitOid"
            },
            "draft": {
              "type": "boolean"
            },
            "mergeable_state": {
              "type": "string"
            },
            "in_merge_queue": {
              "type": "boolean"
            },
            "checks": {
              "$ref": "#/$defs/CheckSummary"
            },
            "review_state": {
              "$ref": "#/$defs/ReviewState"
            }
          },
          "required": [
            "type",
            "state",
            "title",
            "head_sha",
            "base_ref",
            "base_sha",
            "draft",
            "mergeable_state",
            "in_merge_queue",
            "checks",
            "review_state"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "issue"
            },
            "state": {
              "$ref": "#/$defs/ForgeSyncedState"
            },
            "state_reason": {
              "anyOf": [
                {
                  "$ref": "#/$defs/IssueStateReason"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": {
              "$ref": "#/$defs/UntrustedText"
            }
          },
          "required": [
            "type",
            "state",
            "title"
          ]
        }
      ],
      "description": "首次快照的完整字段（event-data §2.2.5.1「首次快照」）：本地第一次看到该 PR / Issue 时\n没有 `from` 可比，改为一次给出该 target 适用的全部白名单字段。"
    }
  },
  "x-gantry-dialect": "https://json-schema.org/draft/2020-12/schema",
  "x-gantry-event-type": "forge.synced",
  "x-gantry-envelope": "schemas/entities/event-envelope.json"
}
