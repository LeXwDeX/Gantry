{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_ref": {
      "$ref": "#/$defs/GuardianEventRef"
    },
    "action": {
      "$ref": "#/$defs/GuardianTriageAction"
    },
    "class": {
      "anyOf": [
        {
          "$ref": "#/$defs/GuardianTriageClass"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "delivery_id": {
      "$ref": "#/$defs/Id_dlv"
    },
    "rule": {
      "type": "string"
    },
    "also_matched": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GuardianTriageClass"
      }
    },
    "config_rev": {
      "$ref": "#/$defs/Seq"
    },
    "reason_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/GuardianReasonCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fingerprint": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sha256Digest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "round_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ulid"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "inbox_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Id_inb"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "defer_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/GuardianDeferReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "action_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Id_act"
      }
    },
    "outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/GuardianRoundOutcome"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "head_before": {
      "anyOf": [
        {
          "$ref": "#/$defs/GitOid"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "head_after": {
      "anyOf": [
        {
          "$ref": "#/$defs/GitOid"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "failing_before": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Sha256Digest"
      },
      "default": null
    },
    "failing_after": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Sha256Digest"
      },
      "default": null
    },
    "progress": {
      "anyOf": [
        {
          "$ref": "#/$defs/GuardianRoundProgress"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "stalled_rounds": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0,
      "default": null
    }
  },
  "required": [
    "event_ref",
    "action",
    "delivery_id",
    "rule",
    "also_matched",
    "config_rev",
    "action_ids"
  ],
  "title": "GuardianTriagedData",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "GuardianEventRef": {
      "title": "GuardianEventRef",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "forge"
            },
            "kind": {
              "type": "string",
              "enum": [
                "pr_opened",
                "pr_reopened",
                "pr_synchronized",
                "pr_updated",
                "pr_closed",
                "pr_merged",
                "base_advanced",
                "pr_enqueued",
                "pr_dequeued",
                "merge_group_checks_requested",
                "merge_group_destroyed",
                "check_suite_completed",
                "check_run_completed",
                "review_submitted",
                "review_dismissed",
                "review_comment",
                "review_thread_changed",
                "issue_comment",
                "issue_closed",
                "issue_reopened",
                "issue_updated",
                "installation_changed",
                "repo_changed"
              ]
            },
            "dedup_key": {
              "type": "string"
            },
            "head_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "source",
            "kind",
            "dedup_key"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "event"
            },
            "event_id": {
              "type": "string"
            }
          },
          "required": [
            "source",
            "event_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "attempt"
            },
            "event_id": {
              "type": "string"
            },
            "attempt_id": {
              "type": "string"
            }
          },
          "required": [
            "source",
            "event_id",
            "attempt_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "settlement"
            },
            "head_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "source",
            "head_sha"
          ]
        }
      ]
    },
    "GuardianTriageAction": {
      "type": "string",
      "enum": [
        "silent_fix",
        "silent_reply",
        "batch",
        "defer",
        "finalize",
        "escalate",
        "round_closed"
      ]
    },
    "GuardianTriageClass": {
      "type": "string",
      "enum": [
        "ci_failure_in_scope",
        "bot_finding_valid",
        "bot_finding_invalid",
        "nit",
        "mechanical_conflict",
        "security_finding",
        "touches_protected_path",
        "scope_expanding_fix",
        "repeated_or_no_progress",
        "budget_exhausted",
        "approval_needed",
        "push_after_approval",
        "design_or_api_change",
        "unknown"
      ],
      "description": "守护分流类 id（config.md §6.1）。锁定类出现在 `triage` 里由 V17 拒绝；\nV17 属于 M2，本节点只保证 id 与取值类型正确。"
    },
    "Id_dlv": {
      "type": "string",
      "pattern": "^dlv_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "Seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "GuardianReasonCode": {
      "type": "string",
      "enum": [
        "guardian.security_finding",
        "guardian.protected_path",
        "guardian.scope_expanding_fix",
        "guardian.repeated_problem",
        "guardian.no_progress",
        "guardian.budget_exhausted",
        "guardian.workflow_run_approval",
        "guardian.push_after_approval",
        "guardian.design_or_api_change",
        "guardian.mechanical_conflict",
        "guardian.ci_failure_escalated",
        "guardian.nit_escalated",
        "guardian.bot_finding_escalated",
        "guardian.ci_out_of_scope",
        "guardian.ci_low_confidence",
        "guardian.ci_startup_failure",
        "guardian.ci_timeout",
        "guardian.scope_unknown",
        "guardian.finding_low_confidence",
        "guardian.human_feedback",
        "guardian.dequeued",
        "guardian.heal_failed",
        "guardian.heal_no_change",
        "guardian.patch_denied",
        "guardian.github_write_failed",
        "guardian.action_denied",
        "guardian.unknown_event"
      ],
      "description": "guardian §7.9 的 27 个上报原因码。"
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Ulid": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "Id_inb": {
      "type": "string",
      "pattern": "^inb_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "GuardianDeferReason": {
      "type": "string",
      "enum": [
        "paused",
        "lock_held",
        "round_active",
        "settling"
      ]
    },
    "Id_act": {
      "type": "string",
      "pattern": "^act_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "GuardianRoundOutcome": {
      "type": "string",
      "enum": [
        "pushed",
        "replied",
        "escalated",
        "no_change",
        "failed",
        "denied",
        "superseded",
        "cancelled"
      ]
    },
    "GitOid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "GuardianRoundProgress": {
      "type": "string",
      "enum": [
        "done",
        "improved",
        "stalled"
      ]
    }
  },
  "x-gantry-dialect": "https://json-schema.org/draft/2020-12/schema",
  "x-gantry-event-type": "guardian.triaged",
  "x-gantry-envelope": "schemas/entities/event-envelope.json"
}
