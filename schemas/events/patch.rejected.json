{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "job_id": {
      "$ref": "#/$defs/Id_att"
    },
    "sha256": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "reason": {
      "$ref": "#/$defs/PatchRejectReason"
    },
    "detail": {
      "type": "string"
    },
    "reasons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PatchReason"
      },
      "default": []
    },
    "config_rev": {
      "anyOf": [
        {
          "$ref": "#/$defs/Seq"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "job_id",
    "sha256",
    "reason",
    "detail"
  ],
  "description": "`patch.rejected`（repo.md §11）。机械拒绝只有 `reason`；`policy_denied` 另带\n`reasons[]` 与 `config_rev`。",
  "title": "PatchRejectedData",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Id_att": {
      "type": "string",
      "pattern": "^att_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "PatchRejectReason": {
      "type": "string",
      "enum": [
        "declared_mismatch",
        "not_applicable",
        "path_invalid",
        "dotgit",
        "binary",
        "symlink",
        "submodule",
        "policy_denied"
      ],
      "description": "`repo` 机械拒绝码；策略拒绝为 `policy_denied`（由 policy 追加 `policy.denied`）。"
    },
    "PatchReason": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/PolicyCode"
        },
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/RepoPath"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rule_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "code"
      ]
    },
    "PolicyCode": {
      "type": "string"
    },
    "RepoPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "Seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "x-gantry-dialect": "https://json-schema.org/draft/2020-12/schema",
  "x-gantry-event-type": "patch.rejected",
  "x-gantry-envelope": "schemas/entities/event-envelope.json"
}
