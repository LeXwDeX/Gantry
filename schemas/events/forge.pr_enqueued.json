{
  "type": "object",
  "properties": {
    "schema": {
      "$ref": "#/$defs/ForgeEventSchema"
    },
    "kind": {
      "const": "pr_enqueued"
    },
    "dedup_key": {
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/ForgeEventSource"
    },
    "delivery_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "project_id": {
      "$ref": "#/$defs/Id_prj"
    },
    "repo": {
      "$ref": "#/$defs/RepoSlug"
    },
    "installation_id": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "delivery_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Id_dlv"
        },
        {
          "type": "null"
        }
      ]
    },
    "target": {
      "$ref": "#/$defs/ForgeEventTarget"
    },
    "actor": {
      "$ref": "#/$defs/ForgeActor"
    },
    "origin": {
      "$ref": "#/$defs/ForgeOrigin"
    },
    "caused_by_action": {
      "anyOf": [
        {
          "$ref": "#/$defs/Id_act"
        },
        {
          "type": "null"
        }
      ]
    },
    "occurred_at": {
      "$ref": "#/$defs/Timestamp"
    },
    "observed_at": {
      "$ref": "#/$defs/Timestamp"
    },
    "stale": {
      "type": "boolean"
    },
    "data": {
      "$ref": "#/$defs/PrEnqueuedData"
    }
  },
  "required": [
    "schema",
    "kind",
    "dedup_key",
    "source",
    "delivery_ids",
    "project_id",
    "repo",
    "installation_id",
    "target",
    "actor",
    "origin",
    "occurred_at",
    "observed_at",
    "stale",
    "data"
  ],
  "description": "`forge.<kind>` 事件的 `data`：forge-actions §6.2 信封。",
  "title": "ForgeEventEnvelope",
  "x-gantry-dialect": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "origin": {
            "const": "self"
          }
        },
        "required": [
          "origin"
        ]
      },
      "then": {
        "required": [
          "caused_by_action"
        ],
        "properties": {
          "caused_by_action": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "PrOpenedData": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "node_id": {
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/ForgeText"
        },
        "body": {
          "$ref": "#/$defs/ForgeText"
        },
        "head": {
          "$ref": "#/$defs/PrHead"
        },
        "base": {
          "$ref": "#/$defs/PrBase"
        },
        "draft": {
          "type": "boolean"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "author": {
          "$ref": "#/$defs/ForgeActor"
        },
        "closing_issues": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "created_by_gantry": {
          "type": "boolean"
        }
      },
      "required": [
        "number",
        "node_id",
        "title",
        "body",
        "head",
        "base",
        "draft",
        "labels",
        "author",
        "closing_issues",
        "created_by_gantry"
      ]
    },
    "ForgeText": {
      "type": "string"
    },
    "PrHead": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string"
        },
        "sha": {
          "$ref": "#/$defs/GitOid"
        },
        "repo": {
          "$ref": "#/$defs/RepoSlug"
        }
      },
      "required": [
        "ref",
        "sha",
        "repo"
      ]
    },
    "GitOid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "RepoSlug": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,100}/[A-Za-z0-9._-]{1,100}$"
    },
    "PrBase": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string"
        }
      },
      "required": [
        "ref"
      ]
    },
    "ForgeActor": {
      "type": "object",
      "properties": {
        "login": {
          "type": "string"
        },
        "github_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "$ref": "#/$defs/ForgeActorKind"
        },
        "association": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "login",
        "github_id",
        "type"
      ],
      "description": "GitHub 侧 actor；全部是外部数据。"
    },
    "ForgeActorKind": {
      "type": "string",
      "enum": [
        "user",
        "bot",
        "app",
        "unknown"
      ]
    },
    "PrReopenedData": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "head_sha": {
          "$ref": "#/$defs/GitOid"
        },
        "base_ref": {
          "type": "string"
        }
      },
      "required": [
        "number",
        "head_sha",
        "base_ref"
      ]
    },
    "PrSynchronizedData": {
      "type": "object",
      "properties": {
        "head_sha": {
          "$ref": "#/$defs/GitOid"
        },
        "previous_head_sha": {
          "$ref": "#/$defs/GitOid"
        },
        "head_epoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "forced": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "base_ref": {
          "type": "string"
        },
        "commits_added": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        }
      },
      "required": [
        "head_sha",
        "previous_head_sha",
        "head_epoch",
        "base_ref"
      ]
    },
    "PrUpdatedData": {
      "type": "object",
      "properties": {
        "changed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PrChangedField"
          }
        }
      },
      "required": [
        "changed"
      ],
      "description": "`changed[]` 的逐字段新值形状在 forge-actions §6.3 未定义，本类型只保留字段名；\n契约补齐新值形状前不猜测（见 `docs/m0-implementation.md` 的缺口处理）。"
    },
    "PrChangedField": {
      "type": "string",
      "enum": [
        "title",
        "body",
        "base",
        "draft",
        "labels",
        "reviewers"
      ]
    },
    "PrClosedData": {
      "type": "object",
      "properties": {
        "head_sha": {
          "$ref": "#/$defs/GitOid"
        },
        "closed_by": {
          "$ref": "#/$defs/ForgeActor"
        }
      },
      "required": [
        "head_sha",
        "closed_by"
      ]
    },
    "PrMergedData": {
      "type": "object",
      "properties": {
        "merge_commit_sha": {
          "$ref": "#/$defs/GitOid"
        },
        "head_sha": {
          "$ref": "#/$defs/GitOid"
        },
        "base_ref": {
          "type": "string"
        },
        "merged_by": {
          "$ref": "#/$defs/ForgeActor"
        },
        "via_merge_queue": {
          "type": "boolean"
        },
        "merge_method": {
          "anyOf": [
            {
              "$ref": "#/$defs/MergeMethod"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "merge_commit_sha",
        "head_sha",
        "base_ref",
        "merged_by",
        "via_merge_queue"
      ]
    },
    "MergeMethod": {
      "type": "string",
      "enum": [
        "merge",
        "squash",
        "rebase"
      ]
    },
    "BaseAdvancedData": {
      "type": "object",
      "properties": {
        "base_ref": {
          "type": "string"
        },
        "before": {
          "$ref": "#/$defs/GitOid"
        },
        "after": {
          "$ref": "#/$defs/GitOid"
        },
        "affected_prs": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        }
      },
      "required": [
        "base_ref",
        "before",
        "after",
        "affected_prs"
      ]
    },
    "PrEnqueuedData": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "head_sha": {
          "$ref": "#/$defs/GitOid"
        }
      },
      "required": [
        "number",
        "head_sha"
      ]
    },
    "PrDequeuedData": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "head_sha": {
          "$ref": "#/$defs/GitOid"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "取值需核实（forge-actions §6.3），不建封闭枚举。",
          "default": null
        }
      },
      "required": [
        "number",
        "head_sha"
      ]
    },
    "MergeGroupChecksRequestedData": {
      "type": "object",
      "properties": {
        "head_sha": {
          "$ref": "#/$defs/GitOid"
        },
        "head_ref": {
          "type": "string"
        },
        "base_ref": {
          "type": "string"
        },
        "base_sha": {
          "$ref": "#/$defs/GitOid"
        },
        "pr_numbers": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        }
      },
      "required": [
        "head_sha",
        "head_ref",
        "base_ref",
        "base_sha",
        "pr_numbers"
      ]
    },
    "MergeGroupDestroyedData": {
      "type": "object",
      "properties": {
        "head_sha": {
          "$ref": "#/$defs/GitOid"
        },
        "reason": {
          "type": "string",
          "description": "官方取值 `merged` / `dequeued` / `invalidated` 的确切字符串需核实，保留原文。"
        }
      },
      "required": [
        "head_sha",
        "reason"
      ]
    },
    "CheckSuiteCompletedData": {
      "type": "object",
      "properties": {
        "check_suite_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "head_sha": {
          "$ref": "#/$defs/GitOid"
        },
        "conclusion": {
          "$ref": "#/$defs/CheckConclusion"
        },
        "app": {
          "$ref": "#/$defs/ForgeApp"
        },
        "pr_numbers": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "is_current_head": {
          "type": "boolean"
        },
        "workflow_runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkflowRun"
          }
        },
        "failed_check_runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FailedCheckRun"
          }
        }
      },
      "required": [
        "check_suite_id",
        "head_sha",
        "conclusion",
        "app",
        "pr_numbers",
        "is_current_head",
        "workflow_runs",
        "failed_check_runs"
      ]
    },
    "CheckConclusion": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "neutral",
        "cancelled",
        "timed_out",
        "action_required",
        "stale",
        "skipped",
        "startup_failure"
      ]
    },
    "ForgeApp": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "slug": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "slug"
      ]
    },
    "WorkflowRun": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "run_attempt": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "conclusion": {
          "$ref": "#/$defs/CheckConclusion"
        }
      },
      "required": [
        "run_id",
        "run_attempt",
        "name",
        "path",
        "conclusion"
      ]
    },
    "FailedCheckRun": {
      "type": "object",
      "properties": {
        "check_run_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "conclusion": {
          "$ref": "#/$defs/CheckConclusion"
        }
      },
      "required": [
        "check_run_id",
        "name",
        "conclusion"
      ]
    },
    "CheckRunCompletedData": {
      "type": "object",
      "properties": {
        "check_run_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "check_suite_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "head_sha": {
          "$ref": "#/$defs/GitOid"
        },
        "conclusion": {
          "$ref": "#/$defs/CheckConclusion"
        },
        "app": {
          "$ref": "#/$defs/ForgeApp"
        },
        "details_url": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "output": {
          "$ref": "#/$defs/CheckRunOutput"
        },
        "annotations_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "required": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "`required` 在 installation token 下是否可用需核实（forge-actions OQ-9）。",
          "default": null
        },
        "is_current_head": {
          "type": "boolean"
        }
      },
      "required": [
        "check_run_id",
        "check_suite_id",
        "name",
        "head_sha",
        "conclusion",
        "app",
        "output",
        "annotations_count",
        "is_current_head"
      ]
    },
    "CheckRunOutput": {
      "type": "object",
      "properties": {
        "title": {
          "$ref": "#/$defs/ForgeText"
        },
        "summary": {
          "$ref": "#/$defs/ForgeText"
        }
      },
      "required": [
        "title",
        "summary"
      ]
    },
    "ReviewSubmittedData": {
      "type": "object",
      "properties": {
        "review_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "state": {
          "$ref": "#/$defs/ReviewState"
        },
        "commit_id": {
          "$ref": "#/$defs/GitOid"
        },
        "reviewer": {
          "$ref": "#/$defs/ForgeActor"
        },
        "body": {
          "$ref": "#/$defs/ForgeText"
        },
        "is_current_head": {
          "type": "boolean"
        },
        "is_bot": {
          "type": "boolean"
        }
      },
      "required": [
        "review_id",
        "state",
        "commit_id",
        "reviewer",
        "body",
        "is_current_head",
        "is_bot"
      ]
    },
    "ReviewState": {
      "type": "string",
      "enum": [
        "approved",
        "changes_requested",
        "commented"
      ]
    },
    "ReviewDismissedData": {
      "type": "object",
      "properties": {
        "review_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "dismissed_by": {
          "$ref": "#/$defs/ForgeActor"
        }
      },
      "required": [
        "review_id",
        "dismissed_by"
      ]
    },
    "ReviewCommentData": {
      "type": "object",
      "properties": {
        "comment_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "review_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "thread_node_id": {
          "type": "string"
        },
        "in_reply_to_id": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "default": null
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        },
        "side": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiffSide"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "commit_id": {
          "$ref": "#/$defs/GitOid"
        },
        "body": {
          "$ref": "#/$defs/ForgeText"
        },
        "diff_hunk": {
          "$ref": "#/$defs/ForgeText"
        },
        "outdated": {
          "type": "boolean"
        }
      },
      "required": [
        "comment_id",
        "review_id",
        "thread_node_id",
        "path",
        "commit_id",
        "body",
        "diff_hunk",
        "outdated"
      ]
    },
    "DiffSide": {
      "type": "string",
      "enum": [
        "head",
        "base"
      ]
    },
    "ReviewThreadChangedData": {
      "type": "object",
      "properties": {
        "thread_node_id": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ReviewThreadState"
        },
        "thread_epoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "thread_node_id",
        "state",
        "thread_epoch"
      ]
    },
    "ReviewThreadState": {
      "type": "string",
      "enum": [
        "resolved",
        "unresolved"
      ]
    },
    "IssueCommentData": {
      "type": "object",
      "properties": {
        "comment_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "on": {
          "$ref": "#/$defs/IssueCommentOn"
        },
        "number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "action": {
          "$ref": "#/$defs/IssueCommentAction"
        },
        "body": {
          "$ref": "#/$defs/ForgeText"
        },
        "author_association": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "comment_id",
        "on",
        "number",
        "action",
        "body"
      ]
    },
    "IssueCommentOn": {
      "type": "string",
      "enum": [
        "issue",
        "pull_request"
      ]
    },
    "IssueCommentAction": {
      "type": "string",
      "enum": [
        "created",
        "edited"
      ]
    },
    "IssueClosedData": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "state_reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "已知 `completed` / `not_planned`，另有取值需核实（forge-actions OQ-12），保留原文。",
          "default": null
        },
        "closed_by": {
          "$ref": "#/$defs/ForgeActor"
        },
        "closed_via_pr": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "default": null
        }
      },
      "required": [
        "number",
        "closed_by"
      ]
    },
    "IssueReopenedData": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "number"
      ]
    },
    "IssueUpdatedData": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "changed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IssueChangedField"
          }
        }
      },
      "required": [
        "number",
        "changed"
      ],
      "description": "与 [`PrUpdatedData`] 相同：逐字段新值形状未定义，只保留字段名。"
    },
    "IssueChangedField": {
      "type": "string",
      "enum": [
        "title",
        "body",
        "labels",
        "assignees"
      ]
    },
    "InstallationChangedData": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/InstallationAction"
        },
        "repos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RepoSlug"
          }
        }
      },
      "required": [
        "action",
        "repos"
      ]
    },
    "InstallationAction": {
