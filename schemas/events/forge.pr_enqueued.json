        "archived",
        "transferred",
        "edited"
      ]
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "ForgeEventSchema": {
      "type": "string",
      "const": "forge.event.v1"
    },
    "ForgeEventKind": {
      "type": "string",
      "enum": [
        "pr_opened",
        "pr_reopened",
        "pr_synchronized",
        "pr_updated",
        "pr_closed",
        "pr_merged",
        "base_advanced",
        "pr_enqueued",
        "pr_dequeued",
        "merge_group_checks_requested",
        "merge_group_destroyed",
        "check_suite_completed",
        "check_run_completed",
        "review_submitted",
        "review_dismissed",
        "review_comment",
        "review_thread_changed",
        "issue_comment",
        "issue_closed",
        "issue_reopened",
        "issue_updated",
        "installation_changed",
        "repo_changed"
      ]
    },
    "ForgeEventSource": {
      "type": "string",
      "enum": [
        "webhook",
        "reconcile"
      ]
    },
    "Id_prj": {
      "type": "string",
      "pattern": "^prj_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "Id_dlv": {
      "type": "string",
      "pattern": "^dlv_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "ForgeEventTarget": {
      "type": "object",
      "properties": {
