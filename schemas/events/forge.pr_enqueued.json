          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "default": null
        },
        "node_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "type"
      ]
    },
    "ForgeTargetType": {
      "type": "string",
      "enum": [
        "pr",
        "issue",
        "branch",
        "installation"
      ]
    },
    "ForgeOrigin": {
      "type": "string",
      "enum": [
        "self",
        "self_unattributed",
        "external"
      ]
    },
    "Id_act": {
      "type": "string",
      "pattern": "^act_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    }
  },
  "x-gantry-projection": {
    "field": "kind",
    "const": "pr_enqueued",
