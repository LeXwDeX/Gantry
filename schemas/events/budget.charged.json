{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ledger": {
      "$ref": "#/$defs/LedgerRef"
    },
    "dimension": {
      "$ref": "#/$defs/BudgetChargedDimension"
    },
    "delta": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "used_after": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "source": {
      "$ref": "#/$defs/BudgetChargeSource"
    },
    "tier": {
      "anyOf": [
        {
          "$ref": "#/$defs/Tier"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/TokenUsage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "weighted_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0,
      "default": null
    },
    "weight_audit": {
      "anyOf": [
        {
          "$ref": "#/$defs/WeightAudit"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "ledger",
    "dimension",
    "delta",
    "used_after",
    "source"
  ],
  "title": "BudgetChargedData",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "LedgerRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "subject": {
              "type": "string",
              "const": "delivery"
            },
            "id": {
              "$ref": "#/$defs/Id_dlv"
            }
          },
          "required": [
            "subject",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "subject": {
              "type": "string",
              "const": "conversation"
            },
            "id": {
              "$ref": "#/$defs/Id_cnv"
            },
            "day": {
              "$ref": "#/$defs/Date"
            }
          },
          "required": [
            "subject",
            "id",
            "day"
          ]
        }
      ],
      "description": "台账引用：交付台账或会话台账（含 UTC 日期，P-58）。"
    },
    "Id_dlv": {
      "type": "string",
      "pattern": "^dlv_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "Id_cnv": {
      "type": "string",
      "pattern": "^cnv_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "Date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "BudgetChargedDimension": {
      "type": "string",
      "enum": [
        "tokens_by_tier",
        "nodes",
        "attempts",
        "wall_time",
        "rounds",
        "forge_writes"
      ]
    },
    "BudgetChargeSource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "attempt"
            },
            "attempt_id": {
              "$ref": "#/$defs/Id_att"
            }
          },
          "required": [
            "kind",
            "attempt_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "direct_call"
            },
            "call_id": {
              "$ref": "#/$defs/Ulid"
            }
          },
          "required": [
            "kind",
            "call_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "node"
            },
            "node_id": {
              "$ref": "#/$defs/Id_nod"
            }
          },
          "required": [
            "kind",
            "node_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "review_round"
            },
            "workflow_id": {
              "$ref": "#/$defs/Id_wfl"
            },
            "round": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "workflow_id",
            "round"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "heal_round"
            },
            "round_id": {
              "$ref": "#/$defs/Ulid"
            }
          },
          "required": [
            "kind",
            "round_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "outbox_action"
            },
            "action_id": {
              "$ref": "#/$defs/Id_act"
            }
          },
          "required": [
            "kind",
            "action_id"
          ]
        }
      ]
    },
    "Id_att": {
      "type": "string",
      "pattern": "^att_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "Ulid": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "Id_nod": {
      "type": "string",
      "pattern": "^nod_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "Id_wfl": {
      "type": "string",
      "pattern": "^wfl_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "Id_act": {
      "type": "string",
      "pattern": "^act_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "Tier": {
      "type": "string",
      "enum": [
        "utility",
        "planner",
        "worker"
      ]
    },
    "TokenUsage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "requests": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "requests"
      ]
    },
    "WeightAudit": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "basis": {
              "type": "string",
              "const": "job_token"
            },
            "config_rev": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "weights": {
              "$ref": "#/$defs/TokenWeights"
            }
          },
          "required": [
            "basis",
            "config_rev",
            "weights"
          ]
        },
        {
          "type": "object",
          "properties": {
            "basis": {
              "type": "string",
              "const": "svc_records"
            },
            "record_count": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "first_seq": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0,
              "default": null
            },
            "last_seq": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0,
              "default": null
            },
            "weight_revs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/WeightRev"
              }
            },
            "records_digest": {
              "$ref": "#/$defs/Sha256Digest"
            }
          },
          "required": [
            "basis",
            "record_count",
            "weight_revs",
            "records_digest"
          ]
        }
      ]
    },
    "TokenWeights": {
      "type": "object",
      "properties": {
        "input": {
          "type": "number",
          "format": "double"
        },
        "output": {
          "type": "number",
          "format": "double"
        },
        "cache_read": {
          "type": "number",
          "format": "double"
        },
        "cache_write": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "input",
        "output",
        "cache_read",
        "cache_write"
      ]
    },
    "WeightRev": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "config_rev": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "weighted_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "config_rev",
        "weighted_tokens"
      ]
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "x-gantry-dialect": "https://json-schema.org/draft/2020-12/schema",
  "x-gantry-event-type": "budget.charged",
  "x-gantry-envelope": "schemas/entities/event-envelope.json"
}
