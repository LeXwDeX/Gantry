{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "rev": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ProviderConfig"
      }
    },
    "groups": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/EgressGroup"
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/EgressProfile"
      }
    },
    "default_profile": {
      "type": "string"
    },
    "injection": {
      "type": "object",
      "maxProperties": 0,
      "x-gantry-unresolved": {
        "reason": "egress-control §4.6 只给出 `injection: {}` 示例，非空字段表未定义（M2）；M0 只接受空对象",
        "source": "docs/interfaces/egress-control.md#46-下发配置视图"
      },
      "default": {}
    },
    "token_weights": {
      "$ref": "#/$defs/TokenWeights"
    }
  },
  "required": [
    "rev",
    "providers",
    "groups",
    "profiles",
    "default_profile",
    "token_weights"
  ],
  "description": "配置视图只含引用，不含 secret 值。\n\n`injection` 的权威依据只有 egress-control §4.6 的示例 `{}`；字段表未定义非空形状\n（M2）。因此 M0 只接受空对象：反序列化、序列化与 schema 都拒绝非空内容，\n`Debug` 不输出其中的值，不猜测未定义结构。",
  "title": "ConfigView",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ProviderConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "base_url": {
          "type": "string"
        },
        "secret_ref": {
          "$ref": "#/$defs/SecretName"
        }
      },
      "required": [
        "kind",
        "base_url",
        "secret_ref"
      ]
    },
    "SecretName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "EgressGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "hosts"
      ]
    },
    "EgressProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "groups"
      ]
    },
    "TokenWeights": {
      "type": "object",
      "properties": {
        "input": {
          "type": "number",
          "format": "double"
        },
        "output": {
          "type": "number",
          "format": "double"
        },
        "cache_read": {
          "type": "number",
          "format": "double"
        },
        "cache_write": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "input",
        "output",
        "cache_read",
        "cache_write"
      ]
    }
  },
  "x-gantry-dialect": "https://json-schema.org/draft/2020-12/schema",
  "x-gantry-injection": "egress-control §4.6 只给出 `injection: {}` 示例；M0 只接受空对象"
}
