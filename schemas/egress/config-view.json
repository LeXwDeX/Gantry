{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "rev": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ProviderConfig"
      }
    },
    "groups": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/EgressGroup"
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/EgressProfile"
      }
    },
    "default_profile": {
      "type": "string"
    },
    "injection": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/InjectionView"
      },
      "default": {},
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
      }
    },
    "token_weights": {
      "$ref": "#/$defs/TokenWeights"
    }
  },
  "required": [
    "rev",
    "providers",
    "groups",
    "profiles",
    "default_profile",
    "token_weights"
  ],
  "title": "ConfigView",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ProviderConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "base_url": {
          "type": "string"
        },
        "secret_ref": {
          "$ref": "#/$defs/SecretName"
        }
      },
      "required": [
        "kind",
        "base_url",
        "secret_ref"
      ]
    },
    "SecretName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "EgressGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "hosts"
      ]
    },
    "EgressProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "groups"
      ]
    },
    "InjectionView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hosts",
        "kind",
        "credential"
      ],
      "properties": {
        "hosts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(\\*\\.)?[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$"
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "bearer",
            "header"
          ]
        },
        "header": {
          "type": "string",
          "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
        },
        "credential": {
          "$ref": "#/$defs/InjectionCredentialView"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "bearer"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "required": [
                "header"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "header"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "header"
            ]
          }
        }
      ]
    },
    "InjectionCredentialView": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secret_ref": {
          "$ref": "#/$defs/SecretName"
        }
      },
      "required": [
        "secret_ref"
      ],
      "description": "下发视图中的凭据引用：只有 `secret_ref`，不包含 `value` / `present`。"
    },
    "TokenWeights": {
      "type": "object",
      "properties": {
        "input": {
          "type": "number",
          "format": "double"
        },
        "output": {
          "type": "number",
          "format": "double"
        },
        "cache_read": {
          "type": "number",
          "format": "double"
        },
        "cache_write": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "input",
        "output",
        "cache_read",
        "cache_write"
      ]
    }
  },
  "x-gantry-dialect": "https://json-schema.org/draft/2020-12/schema",
  "x-gantry-injection": "egress-control §4.6 只给出 `injection: {}` 示例；M0 只接受空对象"
}
