{
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/StagedSecretItem"
      }
    }
  },
  "required": [
    "items"
  ],
  "title": "StagedSecretList",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "StagedSecretItem": {
      "type": "object",
      "properties": {
        "staged_id": {
          "$ref": "#/$defs/StagedId"
        },
        "secret_ref": {
          "$ref": "#/$defs/SecretName"
        },
        "version": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "staged_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "age_s": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "staged_id",
        "secret_ref",
        "version",
        "staged_at",
        "age_s"
      ]
    },
    "StagedId": {
      "type": "string",
      "pattern": "^stg_[0-9A-Z]{26}$"
    },
    "SecretName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  },
  "x-gantry-dialect": "https://json-schema.org/draft/2020-12/schema",
  "x-gantry-source": "egress::StagedSecretList"
}
