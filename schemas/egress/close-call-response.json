{
  "type": "object",
  "properties": {
    "call_id": {
      "$ref": "#/$defs/Ulid"
    },
    "terminal": {
      "$ref": "#/$defs/CallTerminal"
    }
  },
  "required": [
    "call_id",
    "terminal"
  ],
  "description": "调用级关闭的 200 响应。",
  "title": "CloseCallResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Ulid": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "CallTerminal": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/$defs/CallTerminalState"
        },
        "closed_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "last_seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "record_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "svc_token_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SvcTokenId"
          },
          "description": "有已接受请求的 token，升序去重；零接收为空。"
        },
        "usage": {
          "$ref": "#/$defs/TokenUsage"
        },
        "weighted_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "records_digest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "incomplete": {
          "type": "boolean"
        }
      },
      "required": [
        "state",
        "closed_at",
        "last_seq",
        "record_count",
        "svc_token_ids",
        "usage",
        "weighted_tokens",
        "records_digest",
        "incomplete"
      ],
      "description": "只读终结证明（`egress-call-terminal.md` §3）。"
    },
    "CallTerminalState": {
      "type": "string",
      "enum": [
        "closed"
      ]
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "SvcTokenId": {
      "type": "string",
      "pattern": "^svt_[0-9A-Z]{26}$"
    },
    "TokenUsage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "requests": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "requests"
      ]
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "x-gantry-dialect": "https://json-schema.org/draft/2020-12/schema",
  "x-gantry-source": "egress::CloseCallResponse"
}
