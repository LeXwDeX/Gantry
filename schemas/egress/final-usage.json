{
  "type": "object",
  "properties": {
    "job_id": {
      "$ref": "#/$defs/Id_att"
    },
    "state": {
      "$ref": "#/$defs/JobTokenState"
    },
    "revoked_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/Timestamp"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "usage": {
      "$ref": "#/$defs/TokenUsage"
    },
    "weighted_tokens": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "capped": {
      "type": "boolean"
    },
    "incomplete": {
      "type": "boolean"
    },
    "upstream_errors": {
      "$ref": "#/$defs/UpstreamErrors"
    },
    "denied": {
      "$ref": "#/$defs/DeniedCounters"
    }
  },
  "required": [
    "job_id",
    "state",
    "usage",
    "weighted_tokens",
    "capped",
    "incomplete",
    "upstream_errors",
    "denied"
  ],
  "description": "`revoke` 与 `GET …/usage` 共用；`revoked_at` 仅在 `state = revoked` 时出现。",
  "title": "FinalUsage",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Id_att": {
      "type": "string",
      "pattern": "^att_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "JobTokenState": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ]
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "TokenUsage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "requests": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "requests"
      ]
    },
    "UpstreamErrors": {
      "type": "object",
      "properties": {
        "total_5xx": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "total_429": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "total_conn_errors": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_consecutive": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "last_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "total_5xx",
        "total_429",
        "total_conn_errors",
        "max_consecutive"
      ]
    },
    "DeniedCounters": {
      "type": "object",
      "properties": {
        "not_allowed_host": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "path_not_allowed": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "budget_exhausted": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "not_allowed_host",
        "path_not_allowed",
        "budget_exhausted"
      ]
    }
  },
  "x-gantry-dialect": "https://json-schema.org/draft/2020-12/schema",
  "x-gantry-source": "egress::FinalUsage"
}
