{
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/UsageRecord"
      }
    },
    "next_cursor": {
      "type": "string"
    }
  },
  "required": [
    "items",
    "next_cursor"
  ],
  "title": "UsagePage",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "UsageRecord": {
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "at": {
          "$ref": "#/$defs/Timestamp"
        },
        "caller": {
          "$ref": "#/$defs/UsageCaller"
        },
        "project_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id_prj"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ledger": {
          "anyOf": [
            {
              "$ref": "#/$defs/LedgerRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tier": {
          "$ref": "#/$defs/Tier"
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/TokenUsage"
        },
        "weighted_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "incomplete": {
          "type": "boolean"
        }
      },
      "required": [
        "seq",
        "at",
        "caller",
        "tier",
        "provider",
        "model",
        "usage",
        "weighted_tokens",
        "incomplete"
      ]
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "UsageCaller": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "job"
            },
            "job_id": {
              "$ref": "#/$defs/Id_att"
            }
          },
          "required": [
            "kind",
            "job_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "svc"
            },
            "svc_token_id": {
              "$ref": "#/$defs/SvcTokenId"
            },
            "call_id": {
              "$ref": "#/$defs/Ulid"
            }
          },
          "required": [
            "kind",
            "svc_token_id",
            "call_id"
          ]
        }
      ]
    },
    "Id_att": {
      "type": "string",
      "pattern": "^att_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "SvcTokenId": {
      "type": "string",
      "pattern": "^svt_[0-9A-Z]{26}$"
    },
    "Ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "Id_prj": {
      "type": "string",
      "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "LedgerRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "subject": {
              "type": "string",
              "const": "delivery"
            },
            "id": {
              "$ref": "#/$defs/Id_dlv"
            }
          },
          "required": [
            "subject",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "subject": {
              "type": "string",
              "const": "conversation"
            },
            "id": {
              "$ref": "#/$defs/Id_cnv"
            },
            "day": {
              "$ref": "#/$defs/Date"
            }
          },
          "required": [
            "subject",
            "id",
            "day"
          ]
        }
      ],
      "description": "台账引用：交付台账或会话台账（含 UTC 日期，P-58）。"
    },
    "Id_dlv": {
      "type": "string",
      "pattern": "^dlv_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "Id_cnv": {
      "type": "string",
      "pattern": "^cnv_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "Date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "Tier": {
      "type": "string",
      "enum": [
        "utility",
        "planner",
        "worker"
      ]
    },
    "TokenUsage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "requests": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "requests"
      ]
    }
  },
  "x-gantry-dialect": "https://json-schema.org/draft/2020-12/schema",
  "x-gantry-source": "egress::UsagePage"
}
