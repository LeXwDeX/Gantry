  "description": "待执行的 GitHub 写动作；`kind` 与 `payload` 在线上并列，`payload` 按 `kind` 强类型解码。",
  "title": "OutboxAction",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "OutboxActionBase": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id_act"
        },
        "project_id": {
          "$ref": "#/$defs/Id_prj"
        },
        "delivery_id": {
          "$ref": "#/$defs/Id_dlv"
        },
        "idempotency_key": {
          "$ref": "#/$defs/IdempotencyKey"
        },
        "requires_approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id_apr"
            },
            {
              "type": "null"
            }
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id_act"
          }
        },
        "priority": {
          "$ref": "#/$defs/Priority"
        },
        "not_before": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "epoch": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/OutboxStatus"
        },
        "attempts": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "lease_until": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_error": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutboxError"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExpectedEffect"
          }
        },
        "github_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/GithubRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "id",
        "project_id",
        "delivery_id",
        "idempotency_key",
        "depends_on",
        "priority",
        "epoch",
        "status",
        "attempts",
        "expected_effects",
        "created_at",
        "updated_at"
      ],
      "description": "仅用于生成 `OutboxAction` schema 的公共字段；不参与 serde。"
    },
    "Id_act": {
      "type": "string",
      "pattern": "^act_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "Id_prj": {
      "type": "string",
      "pattern": "^prj_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "Id_dlv": {
      "type": "string",
      "pattern": "^dlv_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "IdempotencyKey": {
      "type": "string",
      "pattern": "^gk1_[a-z2-7]{26}$"
    },
    "Id_apr": {
      "type": "string",
      "pattern": "^apr_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "Priority": {
      "type": "string",
      "enum": [
        "high",
        "normal",
        "low"
      ]
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "OutboxStatus": {
      "type": "string",
      "enum": [
        "queued",
        "executing",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "OutboxError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "ExpectedEffect": {
      "type": "object",
      "properties": {
        "event": {
          "type": "string"
        },
        "match": {
          "type": "object",
          "additionalProperties": true
        },
        "matched_webhook_deliveries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "event",
        "match"
      ]
    },
    "GithubRef": {
      "type": "object",
      "properties": {
        "bot": {
          "anyOf": [
            {
              "$ref": "#/$defs/GithubBot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pr": {
          "anyOf": [
            {
              "$ref": "#/$defs/GithubPrRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "marker": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "recorded_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      }
    },
    "GithubBot": {
      "type": "object",
      "properties": {
        "github_id": {
          "type": "integer",
          "format": "int64"
        },
        "login": {
          "type": "string"
        }
      },
      "required": [
        "github_id",
        "login"
      ]
    },
    "GithubPrRef": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "node_id": {
          "type": "string"
        },
        "head_sha": {
          "$ref": "#/$defs/GitOid"
        }
      },
      "required": [
        "number",
        "node_id",
        "head_sha"
      ]
    },
    "GitOid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "PushBranchPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {
          "$ref": "#/$defs/RepoSlug"
        },
        "branch": {
          "type": "string"
        },
        "base_ref": {
          "type": "string"
        },
        "worktree_id": {
          "$ref": "#/$defs/Id_wtr"
        },
        "local_head_oid": {
          "$ref": "#/$defs/GitOid"
        },
        "expected_tree_oid": {
          "$ref": "#/$defs/GitOid"
        },
        "expected_remote_oid": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitOid"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "validation_ref": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "transport": {
          "$ref": "#/$defs/PushTransport"
        },
        "force": {
          "type": "boolean"
        }
      },
      "required": [
        "repo",
        "branch",
        "base_ref",
        "worktree_id",
        "local_head_oid",
        "expected_tree_oid",
        "validation_ref",
        "transport",
        "force"
      ]
    },
    "RepoSlug": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,100}/[A-Za-z0-9._-]{1,100}$"
    },
    "Id_wtr": {
      "type": "string",
      "pattern": "^wtr_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "PushTransport": {
      "type": "string",
      "enum": [
        "git",
        "api"
      ]
    },
    "CreatePrPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {
          "$ref": "#/$defs/RepoSlug"
        },
        "head": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "draft": {
          "type": "boolean"
        },
        "closes": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "expected_head_oid": {
          "$ref": "#/$defs/GitOid"
        },
        "maintainer_can_modify": {
          "type": "boolean"
        }
      },
      "required": [
        "repo",
        "head",
        "base",
        "title",
        "body",
        "draft",
        "closes",
        "expected_head_oid",
        "maintainer_can_modify"
      ]
    },
    "UpdatePrPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {
          "$ref": "#/$defs/RepoSlug"
        },
        "pull_number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "body": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "base": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "repo",
        "pull_number"
      ]
    },
    "PrState": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ]
    },
    "UpsertStatusCommentPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {
          "$ref": "#/$defs/RepoSlug"
        },
        "target": {
          "$ref": "#/$defs/CommentTarget"
        },
        "slot": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "head_sha": {
          "$ref": "#/$defs/GitOid"
        },
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StatusCommentItem"
          }
        }
      },
      "required": [
        "repo",
        "target",
        "slot",
        "revision",
        "head_sha",
        "title",
        "items"
      ]
    },
    "CommentTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/CommentTargetType"
        },
        "number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "number"
      ]
    },
    "CommentTargetType": {
      "type": "string",
      "enum": [
        "pr",
        "issue"
      ]
    },
    "StatusCommentItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/StatusCommentState"
        },
        "label": {
          "type": "string"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "state",
        "label"
      ]
    },
    "StatusCommentState": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "passed",
        "failed",
        "skipped",
        "blocked"
      ]
    },
    "CreateCommentPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {
          "$ref": "#/$defs/RepoSlug"
        },
        "target": {
          "$ref": "#/$defs/CommentTarget"
        },
        "client_ref": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      },
      "required": [
        "repo",
        "target",
        "client_ref",
        "body"
      ]
    },
    "ReplyReviewThreadPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {
          "$ref": "#/$defs/RepoSlug"
        },
        "pull_number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "thread_node_id": {
          "type": "string"
        },
        "in_reply_to_comment_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "body": {
          "type": "string"
        }
      },
      "required": [
        "repo",
        "pull_number",
        "thread_node_id",
        "in_reply_to_comment_id",
        "body"
      ]
    },
    "ResolveReviewThreadPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {
          "$ref": "#/$defs/RepoSlug"
        },
        "pull_number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "thread_node_id": {
          "type": "string"
        },
        "expected_comment_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "description": "仅用于审计，不进幂等键。"
        },
        "fixed_in_oid": {
          "$ref": "#/$defs/GitOid"
        }
      },
      "required": [
        "repo",
        "pull_number",
        "thread_node_id",
        "expected_comment_count",
        "reason",
        "fixed_in_oid"
      ]
    },
    "CreateIssuePayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {
          "$ref": "#/$defs/RepoSlug"
        },
        "client_ref": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assignees": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "milestone": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "default": null
        }
      },
      "required": [
        "repo",
        "client_ref",
        "title",
        "body",
        "labels",
        "assignees"
      ]
    },
    "UpdateIssuePayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {
          "$ref": "#/$defs/RepoSlug"
        },
        "number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "spec_block_markdown": {
          "type": "string"
        },
        "expected_block_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256Digest"
            },
            {
              "type": "null"
            }
          ],
          "description": "`null` 表示正文里还没有 Gantry 规格块（首次写入）。",
          "default": null
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "labels": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "default": null
        }
      },
      "required": [
        "repo",
        "number",
        "spec_block_markdown"
      ]
    },
    "CloseIssuePayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {
          "$ref": "#/$defs/RepoSlug"
        },
        "number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "state_reason": {
          "$ref": "#/$defs/IssueStateReason"
        },
        "require_merged_pr": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "default": null
        }
      },
      "required": [
        "repo",
        "number",
        "state_reason"
      ]
    },
    "IssueStateReason": {
      "type": "string",
      "enum": [
        "completed",
        "not_planned"
