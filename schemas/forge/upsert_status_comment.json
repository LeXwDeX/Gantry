{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "repo": {
      "$ref": "#/$defs/RepoSlug"
    },
    "target": {
      "$ref": "#/$defs/CommentTarget"
    },
    "slot": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "head_sha": {
      "$ref": "#/$defs/GitOid"
    },
    "title": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/StatusCommentItem"
      }
    }
  },
  "required": [
    "repo",
    "target",
    "slot",
    "revision",
    "head_sha",
    "title",
    "items"
  ],
  "title": "UpsertStatusCommentPayload",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "RepoSlug": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,100}/[A-Za-z0-9._-]{1,100}$"
    },
    "CommentTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/CommentTargetType"
        },
        "number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "number"
      ]
    },
    "CommentTargetType": {
      "type": "string",
      "enum": [
        "pr",
        "issue"
      ]
    },
    "GitOid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "StatusCommentItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/StatusCommentState"
        },
        "label": {
          "type": "string"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "state",
        "label"
      ]
    },
    "StatusCommentState": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "passed",
        "failed",
        "skipped",
        "blocked"
      ]
    }
  },
  "x-gantry-dialect": "https://json-schema.org/draft/2020-12/schema",
  "x-gantry-source": "UpsertStatusCommentPayload",
  "x-gantry-action-kind": "upsert_status_comment"
}
