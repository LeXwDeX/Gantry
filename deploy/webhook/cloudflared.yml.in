# tunnel 形态的 webhook 入口（deploy.md §7.6，P-65）：cloudflared 命名隧道（稳定主机名，需自备账号与域名）。
# 只把 /webhook 与 /setup/github/callback 转到回环上的 forge 监听，兜底 404。不使用 smee.io（P-13）。
# 注意：cloudflared 在 Cloudflare 边缘终止 TLS，Cloudflare 能看到 webhook 明文。路径规则语法需核实。
# 隧道凭据文件由管理员用 `cloudflared tunnel create` 生成，不进仓库，也不由 install.sh 生成。
# 由 install.sh 渲染到 /etc/cloudflared/gantry.yml。

tunnel: @TUNNEL_ID@
credentials-file: /etc/cloudflared/@TUNNEL_ID@.json

ingress:
  - hostname: @WEBHOOK_HOST@
    path: ^/webhook$
    service: http://127.0.0.1:@WEBHOOK_PORT@
  - hostname: @WEBHOOK_HOST@
    path: ^/setup/github/callback$
    service: http://127.0.0.1:@WEBHOOK_PORT@
  - service: http_status:404
