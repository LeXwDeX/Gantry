#!/usr/sbin/nft -f
# Gantry 主机防火墙（deploy.md §7.8）。由 install.sh 渲染到 /etc/gantry/gantry.nft。
# 独立表 inet gantry：不碰管理员已有的规则；先 destroy 再定义，重复装载幂等（nftables ≥ 1.0.8）。
# 占位符取值见 install.sh 的 render_args：沙盒侧 Egress 地址、允许访问 mTLS API 的来源网段与各端口。

destroy table inet gantry

table inet gantry {
  set admin_nets {
    type ipv4_addr
    flags interval
    elements = { 192.0.2.0/24, 198.51.100.0/24 }
  }

  chain output {
    type filter hook output priority 0; policy accept;
    # 沙盒用户只允许到 Egress 的沙盒侧端口；其余一律丢弃（含回环上的服务端端口、svc_model、DNS）。
    # 按发起用户过滤依赖 rootless 网络辅助进程以 gantry-sbx 身份发包（需核实，OPS-11）。
    meta skuid "gantry-sbx" ip daddr 10.89.0.1 tcp dport { 8081, 3128 } counter accept
    meta skuid "gantry-sbx" counter drop
  }

  chain input {
    type filter hook input priority 0; policy accept;
    # mTLS API 只接受来自管理网段的连接。
    tcp dport 8443 ip saddr != @admin_nets counter drop
  }
}
